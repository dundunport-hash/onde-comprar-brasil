generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  email             String            @unique
  name              String?
  phone             String?
  image             String?
  passwordHash      String?
  role              String            @default("USER")
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime          @default(now())
  carts             Cart[]
  checkoutAddresses CheckoutAddress[]
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]

  @@index([role])
  @@index([phone])
  @@index([createdAt])
  @@index([resetToken, resetTokenExpiry])
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([createdAt])
}

model Product {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String          @unique
  description   String?
  technicalData String?
  imageUrl      String?
  imageUrl2     String?
  imageUrl3     String?
  ean           BigInt?
  price         Float
  stock         Int             @default(0)
  lengthCm      Float           @default(20)
  widthCm       Float           @default(16)
  heightCm      Float           @default(5)
  weightKg      Float           @default(0.5)
  active        Boolean         @default(true)
  categoryId    String?         @db.ObjectId
  category      Category?       @relation(fields: [categoryId], references: [id])
  prices        ProductPrice[]
  promotions    Promotion[]
  coupons       CouponProduct[]
  cartItems     CartItem[]
  stocks        Stock[]
  movements     StockMovement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([active])
  @@index([categoryId])
  @@index([stock])
  @@index([createdAt])
  @@index([active, stock])
}

model Cart {
  id                       String           @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String?          @db.ObjectId
  user                     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousToken           String?          @unique
  status                   CartStatus       @default(ACTIVE)
  items                    CartItem[]
  checkoutAddress          CheckoutAddress?
  shippingPostalCode       String?
  shippingMethod           String?
  shippingLabel            String?
  shippingPrice            Float?
  shippingEstimatedDays    Int?
  shippingCalculatedAt     DateTime?
  prescriptionImageUrl     String?
  prescriptionUploadedAt   DateTime?
  shipmentId               String?
  shipmentTrackingCode     String?
  shipmentLabelRequestId   String?
  shipmentStatus           String?
  shipmentError            String?
  shipmentPayload          Json?
  shipmentResponse         Json?
  shipmentCreatedAt        DateTime?
  shipmentLabelRequestedAt DateTime?
  stripeCheckoutSessionId  String?          @unique
  stripePaymentIntentId    String?
  mercadoPagoPaymentId     String?          @unique
  mercadoPagoStatus        String?
  mercadoPagoStatusDetail  String?
  pixQrCode                String?
  pixQrCodeBase64          String?
  pixTicketUrl             String?
  paymentStatus            PaymentStatus    @default(PENDING)
  paidAt                   DateTime?
  stockDeductedAt          DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  expiresAt                DateTime?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([updatedAt])
  @@index([paidAt])
  @@index([shipmentId])
  @@index([shipmentTrackingCode])
  @@index([expiresAt])
  @@index([status, updatedAt])
  @@index([paymentStatus, updatedAt])
}

model Coupon {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  code            String          @unique
  discountPercent Float
  active          Boolean         @default(true)
  products        CouponProduct[]
  cartItems       CartItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([active])
  @@index([createdAt])
}

model CouponProduct {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId  String   @db.ObjectId
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
}

model CartItem {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId                String   @db.ObjectId
  cart                  Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId             String   @db.ObjectId
  product               Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity              Int      @default(1)
  unitPrice             Float
  baseUnitPrice         Float?
  couponId              String?  @db.ObjectId
  coupon                Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode            String?
  couponDiscountPercent Float?
  couponDiscountAmount  Float    @default(0)
  couponFinalUnitPrice  Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([couponId])
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  AWAITING_SHIPMENT
  SEPARATED_SHIPPED
  DELIVERED
  AWAITING_PICKUP
  ABANDONED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

model CheckoutAddress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId       String   @unique @db.ObjectId
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId       String?  @db.ObjectId
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  document     String?
  phone        String
  postalCode   String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([postalCode])
}

model StripeWebhookEvent {
  id          String    @id @map("_id")
  type        String
  objectId    String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([type, objectId])
  @@index([type])
  @@index([objectId])
}

model MercadoPagoWebhookEvent {
  id          String    @id @map("_id")
  type        String
  action      String?
  objectId    String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([type, objectId, action])
  @@index([type])
  @@index([objectId])
}

model Stock {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  productId        String          @db.ObjectId
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch            String?
  quantity         Int             @default(0)
  reservedQuantity Int             @default(0)
  minimumQuantity  Int             @default(0)
  expirationDate   DateTime?
  receivedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  movements        StockMovement[]

  @@index([productId])
  @@index([expirationDate])
  @@index([quantity])
}

model StockMovement {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  type             StockMovementType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  notes            String?
  expirationDate   DateTime?
  productId        String            @db.ObjectId
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockId          String            @db.ObjectId
  stock            Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  createdById      String?           @db.ObjectId
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([stockId])
  @@index([type])
  @@index([expirationDate])
  @@index([createdAt])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  LOSS
  RETURN
  EXPIRED
}

model ProductPrice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  price     Float
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Promotion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  discountPercent Float    @default(0)
  discountFixed   Float    @default(0)
  startDate       DateTime
  endDate         DateTime
  active          Boolean  @default(true)
  productId       String?  @db.ObjectId
  product         Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([active, startDate, endDate])
}

model SitePageContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  action     String
  entity     String
  entityId   String?
  actorId    String?  @db.ObjectId
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
